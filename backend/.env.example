# Copy to .env (PowerShell: Copy-Item .env.example .env). No secrets or API keys are needed.
DEEPTRACE_MAX_UPLOAD_MB=10
DEEPTRACE_MAX_PIXELS=25000000
DEEPTRACE_ELA_QUALITY=90
# Comma-separated list of allowed frontend origins (CORS). Use * only for local experiments.
DEEPTRACE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Delete analyses (and their files) older than N days on startup. 0 = keep forever.
DEEPTRACE_RETENTION_DAYS=30
# Keep a downscaled preview image so the PDF can show the analysed image.
DEEPTRACE_STORE_PREVIEW=true
# GPS coordinates are redacted by default (privacy). Set true to include them in results.
DEEPTRACE_INCLUDE_GPS_VALUES=false
# "none" = no AI detector (default). See app/analysis/ai_detection.py to add one.
DEEPTRACE_AI_DETECTOR=none
# Optional overrides
# DEEPTRACE_STORAGE_DIR=storage
# DEEPTRACE_DATABASE_PATH=storage/deeptrace.db
